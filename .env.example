# Variabili usate davvero da server.js
# PORT: porta su cui parte il server (Render la imposta da sola in produzione)
PORT=3000
# ADMIN_TOKEN: se impostata, admin.html deve fornirla (header X-Admin-Token) per
# pubblicare/cancellare giornate e dettagli via /api/*. Lasciala vuota per non richiederla.
ADMIN_TOKEN=
